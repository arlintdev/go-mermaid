quadrantChart
  title Risk register
  x-axis Low likelihood --> High likelihood
  y-axis Low impact --> High impact
  quadrant-1 Act now
  quadrant-2 Plan
  quadrant-3 Accept
  quadrant-4 Watch
  R-01: [0.70, 0.70] color: #D64541
  R-02: [0.25, 0.80] radius: 10, color: #f39c12, stroke-color: #222, stroke-width: 2px
  R-03:::low: [0.20, 0.15]
  R-04:::high: [0.85, 0.40]
  classDef low color: #27ae60, radius: 8
  classDef high color: #8e44ad, stroke-color: #000, stroke-width: 3px
